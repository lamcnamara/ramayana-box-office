  "reception": [
    {
      "market": "uk-ireland",
      "label": "United Kingdom",
      "type": "Criticism",
      "text": "Peter Bradshaw found Rama’s exile unexpectedly lively. In The Guardian, he singled out the sunset landscapes and the eccentric flying machine as pleasures of seeing the story on this scale.",
      "sources": [
        "guardian"
      ]
    },
    {
      "market": "australia",
      "label": "Australia",
      "type": "Audience reporting",
      "text": "In Indian Link, Torrsha Sen traced the opening to Indian-Australian communities. She described how viewers who knew the epic from family storytelling could encounter it again on an IMAX screen. The article gives a community perspective. It does not provide a film-specific demographic survey.",
      "sources": [
        "indianlink"
      ]
    },
    {
      "market": "france",
      "label": "France",
      "type": "Criticism and viewer reviews",
      "text": "Isabelle Arnaud admired the costumes and score but found the digital treatment of some actors distracting. On AlloCiné, one viewer singled out Yash’s Ravana and called the storytelling dense. Another felt the music carried the long running time. Both chose to post their reviews.",
      "sources": [
        "unification",
        "fr-viewers"
      ]
    },
    {
      "market": "vietnam",
      "label": "Vietnam",
      "type": "Ticket buyers and criticism",
      "text": "MoMo displayed 9.3/10 from about 1,500 ratings by people who bought tickets on its platform. In VOH’s review, Ravana’s conflicting inner voices made him the more interesting character. The reviewer felt that the effects sometimes obscured the bond between Rama and Lakshman.",
      "sources": [
        "momo",
        "voh"
      ]
    },
    {
      "market": "brazil",
      "label": "Brazil",
      "type": "Criticism",
      "text": "Nane Tasca reviewed the long Hindi version for MeUGamer ahead of the Brazilian release. Seeing Ravana’s people suffer made his later cruelty intelligible to her, and she found the shifts between music, action and story kept the three hours moving. Her review identifies a shorter dubbed theatrical version.",
      "sources": [
        "meugamer"
      ]
    }
  ]
}
